# Africa's Talking app username. For the sandbox it is always "sandbox" and the kit sets that for you.
AT_USERNAME=
# API key from the app's Settings, API Key page. Use the sandbox app's key while building.
AT_API_KEY=
# Your approved alphanumeric sender ID or short code, spelled exactly as approved. Leave empty in the sandbox.
AT_SENDER_ID=
# KES per SMS part from your own Africa's Talking price list. No default on purpose.
SMS_RATE_PER_SEGMENT=
# Random secret for the callback URLs, letters and digits only. Make one with: openssl rand -hex 24
CALLBACK_TOKEN=
# Port for server.js (3000 when empty) and the folder for the JSON files (data when empty).
PORT=
DATA_DIR=
